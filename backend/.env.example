PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/mks_reservation
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_ACCESS_PASSWORD=change-this-admin-password
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=
RESERVATION_QUOTA_LIMIT=16
MAIL_PROVIDER=gmail_api
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
RESEND_API_KEY=
EMAIL_API_TIMEOUT_MS=15000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_FROM="MakerSpace <your-gmail-address>"
PASSWORD_RESET_URL_BASE=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
AUTO_SEED_DATA=true
FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600

# Slicing worker only. P1S network access is not required for estimation.
BAMBU_STUDIO_CLI=/opt/bambu-studio/bambu-studio
BAMBU_STUDIO_USE_XVFB=true
BAMBU_MACHINE_PROFILE=/opt/bambu-profiles/machine.json
BAMBU_PROCESS_PROFILE=/opt/bambu-profiles/process.json
BAMBU_FILAMENT_PROFILE=/opt/bambu-profiles/filament.json
BAMBU_PROFILE_VERSION=P1S-0.4-Bambu-PLA-Basic
SLICER_POLL_MS=3000
SLICER_TIMEOUT_MS=300000
SLICER_STALE_LOCK_MS=900000
